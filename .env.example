# RedFlagged — local development credentials
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# ── CyberArk (production) ──────────────────────────────────────────────────
# Leave blank for local dev; set these in the production environment.
CYBERARK_HOST=
CYBERARK_APP_ID=RedFlagged
CYBERARK_SAFE=RedFlagged-dev

# ── Azure credentials (local dev only — ignored when CYBERARK_HOST is set) ──
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# ── Database ──────────────────────────────────────────────────────────────
# Leave blank to use SQLite (default — zero setup, creates redflagged.db locally)
# For Azure SQL (production):
# SQL_CONNECTION_STRING=mssql+pyodbc://user:password@server.database.windows.net/redflagged?driver=ODBC+Driver+18+for+SQL+Server
SQL_CONNECTION_STRING=

# ── Mailbox to search for DLP notifications ───────────────────────────────
# Use a UPN (user@domain.com) or Azure AD object ID.
# "me" only works with delegated auth — use explicit UPN for app-only auth.
MAIL_USER_ID=admin@M365x04231595.onmicrosoft.com

# ── ServiceNow (assignment group validation) ──────────────────────────────
SNOW_INSTANCE_URL=https://your-instance.service-now.com
SNOW_USERNAME=your-servicenow-username
SNOW_PASSWORD=your-servicenow-password

# ── Current analyst identity (server-side only — never from frontend) ─────
# In production this comes from SSO/session token. For local dev, set your email.
CURRENT_USER_EMAIL=analyst@yourcompany.com

# ── Authentication ────────────────────────────────────────────────────────────
# Phase 1: json (local file). Phase 2: cyberark or oidc.
AUTH_PROVIDER=json
